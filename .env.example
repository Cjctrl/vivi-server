# ── Models ────────────────────────────────────────────────────────────────────
CONDUCTOR_MODEL=qwen3:8b-q4
WEB_SEARCH_MODEL=llama3.1:8b-q4
EMBED_MODEL=nomic-embed-text
CODING_MODEL=qwen2.5-coder:14b-q4
REASONING_MODEL=deepseek-r1:14b-q4
MATH_MODEL=phi4:14b-q4
REFLECTION_MODEL=deepseek-r1:14b-q4
VISUAL_CONTEXT_MODEL=qwen2.5vl:7b-q4
GRAPH_TRAVERSAL_MODEL=qwen2.5-coder:7b-q4
HEAVY_CODING_MODEL=qwen2.5-coder:32b-q3
HEAVY_REASONING_MODEL=deepseek-r1:32b-q3
VISION_MODEL=llava:13b

# ── VRAM / runtime ────────────────────────────────────────────────────────────
MAX_VRAM_USAGE_GB=14.0
VRAM_HEADROOM_GB=2.0
AGENT_THREAD_WORKERS=12
LOG_LEVEL=INFO

# ── Qdrant vector store ───────────────────────────────────────────────────────
# Leave unset to use the embedded disk-backed client (default).
# QDRANT_URL=http://localhost:6333

# ── Paths ─────────────────────────────────────────────────────────────────────
VAULT_PATH=C:\ai obsidain-code
MEMORY_DB_PATH=./memory/vivi_db
EPISODIC_DB_PATH=./memory/episodic_db
SCHOOL_DB_PATH=./db/school.db
SANDBOX_DIR=./sandbox
LOG_FILE=conductor.log

# ── School integrations (optional) ───────────────────────────────────────────
POWERSCHOOL_URL=
POWERSCHOOL_USERNAME=
POWERSCHOOL_PASSWORD=

# ── Chrome remote debugging (study mode / doc reading) ────────────────────────
# SECURITY RISK: setting this to true launches Chrome with
# --remote-debugging-port=9222, an UNAUTHENTICATED CDP endpoint on localhost.
# Any local process — or a malicious web page via DNS rebinding — can then drive
# your browser, read every open tab, and steal logged-in cookies/sessions.
# Leave it false unless you actively need VIVI to read Google Docs / browser PDFs,
# and prefer a dedicated throwaway Chrome profile when you do enable it.
ENABLE_CHROME_DEBUGGING=false
# CHROME_DEBUG_PORT=9222

# ── Overlay WebSocket auth (port 7300) ────────────────────────────────────────
# Shared secret for the HMAC challenge-response gate on destructive WS commands
# (app_launch_request, confirm_file_write, open_in_explorer/vscode, notes_save,
# shutdown). REQUIRED — the server fails to start if this is unset.
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
WS_SECRET=

# ── NEXUS API auth (port 7200) ────────────────────────────────────────────────
# Shared secret gating the mutating NEXUS endpoints (POST/PATCH/DELETE on the
# knowledge base). Clients send it as `Authorization: Bearer <token>` or
# `X-Nexus-Token: <token>`. GET routes stay open. REQUIRED — settings import
# fails if unset. Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
NEXUS_SECRET=

# ── Sandbox isolation for LLM-generated code ──────────────────────────────────
# Keep both true. They strip secrets from the sandbox env and confine the cwd.
# Note: true isolation still requires Docker/nsjail/Windows Sandbox.
SANDBOX_NETWORK_DISABLED=true
SANDBOX_ROOT_DISABLED=true
