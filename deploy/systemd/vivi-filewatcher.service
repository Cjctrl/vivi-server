[Unit]
Description=V.I.V.I NEXUS file watcher (re-embed on KB change)
After=vivi-nexus.service
Requires=vivi-nexus.service

[Service]
User=vivi
Group=vivi
WorkingDirectory=/opt/vivi/vivi-server
EnvironmentFile=/etc/vivi/vivi.env
# Wait for NEXUS to actually answer before watching (ordering != readiness).
ExecStartPre=/bin/sh -c 'until curl -sf http://127.0.0.1:7200/health >/dev/null; do sleep 1; done'
ExecStart=/usr/bin/node memory/nexus/file_watcher.js
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vivi

[Install]
WantedBy=multi-user.target
