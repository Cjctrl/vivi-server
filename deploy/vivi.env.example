# =============================================================================
# V.I.V.I server environment
# Copy to /etc/vivi/vivi.env  (owner root:vivi, chmod 0640).
# systemd injects this via EnvironmentFile=. config.settings uses
# os.environ.setdefault, so values here take precedence over any repo .env.
# Generate a secret:  python3 -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# --- Required secrets (settings.py refuses to import without these) ----------
WS_SECRET=CHANGE_ME
NEXUS_SECRET=CHANGE_ME

# --- NEXUS memory server (:7200, loopback only) ------------------------------
NEXUS_HOST=127.0.0.1
NEXUS_PORT=7200
# Require the token on reads too. Recommended on a server, and REQUIRED if the
# desktop overlay/HUD is a separate machine reaching NEXUS over Tailscale.
NEXUS_REQUIRE_READ_AUTH=true

# --- Qdrant ------------------------------------------------------------------
# Run Qdrant as a SHARED server. Embedded mode (QdrantClient(path=...)) can be
# opened by only ONE process, but the NEXUS server AND the gateway both use the
# vector store — so point both at a standalone Qdrant on loopback.
QDRANT_URL=http://127.0.0.1:6333

# --- Mobile gateway (:7400) --------------------------------------------------
# Bind to THIS host's Tailscale IP (run: tailscale ip -4). Leave 127.0.0.1 to
# disable remote reachability entirely.
TAILSCALE_BIND_IP=127.0.0.1

# --- Writable data (kept under /var/lib/vivi so /opt code stays read-only) ----
NEXUS_KB_PATH=/var/lib/vivi/knowledge_base
MEMORY_DB_PATH=/var/lib/vivi/memory/vivi_db
EPISODIC_DB_PATH=/var/lib/vivi/memory/episodic_db
SCHOOL_DB_PATH=/var/lib/vivi/db/school.db
SANDBOX_DIR=/var/lib/vivi/sandbox
SCHEDULER_DB=/var/lib/vivi/data/scheduler.db
WAKE_LEARN_DB=/var/lib/vivi/data/wake_patterns.db
ARRIVAL_LEARN_DB=/var/lib/vivi/data/arrival_patterns.db
PLACE_LEARN_DB=/var/lib/vivi/data/places.db
CAPABILITY_REGISTRY_PATH=/var/lib/vivi/data/capability_registry.json
LOG_FILE=/var/lib/vivi/logs/conductor.log

# --- Safety ------------------------------------------------------------------
# Keep LLM-generated code execution OFF on an always-on / remotely reachable
# box. The governance pipeline still plans/reviews; it just won't run code.
CODING_AGENT_EXECUTION_ENABLED=false

# --- Home automation / location (PII — fill in; never commit real values) -----
HOME_LAT=0.0
HOME_LNG=0.0
HOME_GEOFENCE_RADIUS_M=1000
LOCATION_AUTH_USER=vivi
WOL_TARGET_MAC=
# WOL_BROADCAST_IP=255.255.255.255

# --- School integrations (optional) ------------------------------------------
# POWERSCHOOL_URL=
# POWERSCHOOL_USERNAME=
# POWERSCHOOL_PASSWORD=

# --- zim_kb offline knowledge base (vivi-server) -----------------------------
# 24+ GB of .zim archives + cache live here. Regenerable — excluded from backup.
# VIVI_MEMDSK_PATH=/var/lib/vivi/zim_kb_data
